<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RoadExp.Presentation.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="450"
             x:Class="RoadExp.Presentation.Avalonia.Views.DistanceSensorPageView"
             x:DataType="vm:DistanceSensorPageViewModel">
<StackPanel>
    <TextBlock FontSize="20"
            FontStyle="Oblique"
            TextAlignment="Left"
            Margin="350 20 0 50">
        Датчик пройденного пути
    </TextBlock>
    <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="550"/>
        <ColumnDefinition Width="550"/>
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Column="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>   

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions> 

            <!-- Impulse counter -->
            <TextBlock Grid.Column="0" 
                        Grid.Row="0"
                        Padding="20 10 0 0"
                        VerticalAlignment="Center">
                Кол-во импульсов:
            </TextBlock>
            <TextBox Grid.Column="1"
                     Grid.Row="0"
                     Margin="0 10 0 0"
                     IsReadOnly="True"
                     Text="{Binding ImpulseCounter}"/>

            <!-- Distance -->
            <TextBlock Grid.Column="0"
                       Grid.Row="1"
                       Padding="20 10 0 0"
                        VerticalAlignment="Center">
                Пройденный путь, км:
            </TextBlock>

            <TextBox Grid.Column="1"
                     Grid.Row="1"
                     Margin="0 10 0 0"
                     IsReadOnly="True"
                     Text="{Binding Distance}"/>

            <!-- Speed -->
            <TextBlock Grid.Column="0"
                       Grid.Row="2"
                       Padding="20 10 0 0"
                        VerticalAlignment="Center">
                Скорость, км/ч:
            </TextBlock>

            <TextBox Grid.Column="1"
                     Grid.Row="2"
                     Margin="0 10 0 0"
                     IsReadOnly="True"
                     Text="{Binding Speed}"/>              
        </Grid>
    </StackPanel>

    <StackPanel Grid.Column="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>   

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions> 

            <!-- Correction factor -->
            <TextBlock Grid.Column="0" 
                        Grid.Row="0"
                        Padding="20 10 0 0"
                        VerticalAlignment="Center">
                Поправочный коэффициент:
            </TextBlock>
            <NumericUpDown Grid.Column="1"
                     Grid.Row="0"
                     Margin="0 10 0 0"                     
                     Value="{Binding CorrectionFactor}"/>

            <!-- Polarity -->
            <TextBlock Grid.Column="0"
                       Grid.Row="1"
                       Padding="20 10 0 0"
                        VerticalAlignment="Center">
                Полярность:
            </TextBlock>

            <ComboBox Grid.Column="1"
                     Grid.Row="1"
                     Margin="0 10 0 0"
                     Width="223"                     
                     ItemsSource="{Binding Polarities}"
                     SelectedIndex="{Binding PolarityIndex}"/>

            <!-- Reverse -->
            <TextBlock Grid.Column="0"
                       Grid.Row="2"
                       Padding="20 10 0 0"
                        VerticalAlignment="Center">
                Реверс:
            </TextBlock>

            <ComboBox Grid.Column="1"
                     Grid.Row="2"
                     Margin="0 10 0 0"
                     Width="223"
                     ItemsSource="{Binding Reverse}"
                     SelectedIndex="{Binding ReverseIndex}"/>              
        </Grid>
    </StackPanel>
    <StackPanel Grid.Column="0"
                Grid.Row="1"
                Margin="20 20 0 0">
        <CheckBox IsChecked="{Binding IsEmulationMode}">                    
            Эмуляция
        </CheckBox>
    </StackPanel>
</Grid>
<DockPanel Height="300">
    
    <StackPanel Orientation="Horizontal"
                DockPanel.Dock="Bottom">        
        <Button Command="{Binding Initialize}"
                Margin="20 0 0 0">Initialize</Button>
        <Button Command="{Binding Start}"
                Margin="20 0 0 0">Start</Button>
        <Button Command="{Binding Stop}"
                Margin="20 0 0 0">Stop</Button>
        <Button Command="{Binding Deinitialize}"
                Margin="20 0 0 0">Deinitialize</Button>
    </StackPanel>
</DockPanel>
</StackPanel>
</UserControl>
