<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RoadExp.Presentation.Avalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="RoadExp.Presentation.Avalonia.Views.ComputerPageView"
             x:DataType="vm:ComputerPageViewModel">
<Grid>
<Grid.RowDefinitions>
  <RowDefinition Height="Auto"/>
  <RowDefinition Height="*"/>
</Grid.RowDefinitions>
  <StackPanel Grid.Row="0" Orientation="Horizontal">
    <Button Command="{Binding CreateSystem}"
            Margin="10 10 0 0">
          Создать
    </Button>
  
    <Button Command="{Binding InitializeSystem}"
            Margin="10 10 0 0">
          Инициализировать
    </Button>

    <Button Command="{Binding StartAcquisition}"
            Margin="10 10 0 0">
          Старт
    </Button>

    <Button Command="{Binding StopAcquisition}"
            Margin="10 10 0 0">
          Стоп
    </Button>
  </StackPanel>

  <DockPanel Grid.Row="1"
              Margin="0 30 0 0">      
  <Grid DockPanel.Dock="Left" Margin="20 0 0 0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>  
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Column="0"
                Grid.Row="0"
                Margin="0 10 0 10"
                VerticalAlignment="Center">
              Процессор, %
    </TextBlock>

    <TextBox Grid.Column="1" 
             Grid.Row="0" 
             Text="{Binding ProcessorUsage}"
             Width="200"
             Margin="10 10 0 10"
             HorizontalAlignment="Left"
             IsReadOnly="True"/>

    <TextBlock Grid.Column="0"
                Grid.Row="1"
                VerticalAlignment="Center">
              Память, Мб
    </TextBlock>

    <TextBox Grid.Column="1" 
             Grid.Row="1" 
             Text="{Binding AvailableMemory}"
             Width="200"
             Margin="10 0 0 0"
             HorizontalAlignment="Left"
             IsReadOnly="True"/>

  </Grid>
  </DockPanel>
  </Grid>
</UserControl>
